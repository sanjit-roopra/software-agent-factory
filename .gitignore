.venv/
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
coverage.xml
htmlcov/
*.egg-info/
*.py[cod]

# Build and release artifacts (PLAN.md Phase 15.1/15.2). Everything under
# packaging/ except the checked-in PyInstaller spec is generated output, and
# build-info.json is written per build by scripts/release/generate_build_info.py.
dist/
build/
packaging/*
!packaging/pyinstaller.spec
src/software_agent_factory/build-info.json

# Documentation site output (mkdocs build).
site/

# dev-team workflow runtime artifacts (.claude/-scoped + .dev-team-reports/, #1406) v2 (regeneratable; not deliverables — issues #1101, #1377, #1406, #1412)
.claude/memory/
.claude/metrics/
.claude/plans/
# Per-session hook state (transcript id, turn counter); rewritten every turn.
.claude/code-intelligence-turn-state.json
/.dev-team-reports/*
!/.dev-team-reports/test-improve/
memory/
reports/
metrics/
plans/
.pr-review-passed

# dev-team hygiene — machine-specific MCP config (absolute-path pollution — issues #1376, #1416)
.mcp.json
.vscode/mcp.json

# code-intelligence indexes (machine-local; dev-team project-init)
.codegraph/
.repowise/
graphify-out/
